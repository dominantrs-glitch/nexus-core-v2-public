{
  "name": "nexus-core-v2-cloudflare-probe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:relay": "vitest run --config vitest.relay.config.ts",
    "test:git": "vitest run --config vitest.git.config.ts",
    "typecheck": "tsc --noEmit",
    "build:git-local": "esbuild src/git-local.ts --bundle --platform=node --format=esm --outfile=dist/git-local.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:relay": "wrangler deploy --config wrangler.relay.jsonc --dry-run --outdir dist/relay",
    "dev": "wrangler dev --local"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/node": "24.13.6",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
